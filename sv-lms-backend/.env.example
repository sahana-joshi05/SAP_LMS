# SV LMS backend — environment variables
#
# Spring Boot doesn't read .env files natively. Use one of:
#   - export these in your shell / systemd service / CI secrets before `mvn spring-boot:run`
#   - pass them via `environment:` in docker-compose.yml if you containerize the backend
#   - set them in your hosting platform's environment variable settings (Render, Railway, etc.)
#
# Every variable below has a safe LOCAL DEV default baked into application.yml, so none
# of this is required to run locally. It becomes required before deploying anywhere real.

# --- Security (required before production - see SecurityStartupCheck.java) ---
JWT_SECRET=replace_with_a_long_random_value_at_least_32_characters
JWT_EXPIRATION_MS=43200000
CORS_ALLOWED_ORIGIN=https://your-real-frontend-domain.com

# --- Password reset links point here (see AuthService.forgotPassword) ---
FRONTEND_BASE_URL=https://your-real-frontend-domain.com

# --- Email sending ---
# Gmail requires an App Password, not your normal Gmail password.
# Turn this on only after MAIL_PASSWORD is set in your machine/hosting secrets.
MAIL_ENABLED=false
MAIL_FAIL_USER_CREATE_ON_SEND_ERROR=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=svcuriotech@gmail.com
MAIL_PASSWORD=replace_with_gmail_app_password
MAIL_FROM=svcuriotech@gmail.com

# --- Login rate limiting (defaults are usually fine, tune if needed) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/svlms
DB_USERNAME=postgres
DB_PASSWORD=replace_with_a_real_password

# --- Schema management ---
# Flyway (src/main/resources/db/migration/) now owns the schema. Leave this as
# 'validate' in any real environment - it just double-checks Hibernate's entity
# mappings match what Flyway created, and fails loudly if they don't.
DDL_AUTO=validate
SHOW_SQL=true

# --- Server ---
SERVER_PORT=8080
